{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/*"],
      "@assets/*": ["src/assets/*"],
      "components": ["src/design-system/components"],
      "design-system": ["src/design-system"],
      "pages": ["src/pages"],
      "hooks": ["src/hooks"],
      "lib": ["src/lib"],
      "data": ["src/data"],
      "api": ["src/data/api"],
      "queries": ["src/data/queries"],
      "state": ["src/data/state"],
      "forms": ["src/forms"],
      "i18n": ["src/i18n"],
      "mocks": ["src/mocks"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
