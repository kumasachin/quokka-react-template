# API Configuration
# Set to 'true' to use mock data instead of real API calls
# Set to 'false' or leave unset to make real API calls to backend server
VITE_ENABLE_MOCKING=true

# Backend API base URL
# When VITE_ENABLE_MOCKING=false, this URL will be used for API calls
VITE_API_BASE_URL=http://localhost:3002
