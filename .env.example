# API Configuration (for local frontend)
VITE_API_BASE_URL=http://localhost:3001/api

# Postgres database (for Vercel deployments)
# Set this to a full postgres connection string when deploying
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# Development
NODE_ENV=development

# Client URL allowed for CORS when running the local server
CLIENT_URL=http://localhost:5173
